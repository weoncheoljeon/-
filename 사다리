<!DOCTYPE html>
<html lang="ko">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>5인용 스릴만점 사다리타기 게임</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }
        body {
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
            background: linear-gradient(135deg, #f5f7fa, #c3cfe2);
            color: #333;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            align-items: center;
            padding: 20px;
        }
        h1 {
            margin-bottom: 20px;
            color: #2c3e50;
            font-size: 1.8rem;
            text-align: center;
        }
        .container {
            background: #ffffff;
            padding: 25px;
            border-radius: 15px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            max-width: 600px;
            width: 100%;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
        .section {
            width: 100%;
            margin-bottom: 15px;
        }
        .section h3 {
            font-size: 1rem;
            margin-bottom: 8px;
            color: #34495e;
        }
        .input-group {
            display: flex;
            gap: 8px;
            justify-content: space-between;
        }
        .input-group input {
            width: 18%;
            padding: 8px;
            border: 2px solid #ddd;
            border-radius: 6px;
            text-align: center;
            font-size: 0.9rem;
            outline: none;
            transition: border-color 0.2s;
        }
        .input-group input:focus {
            border-color: #3498db;
        }
        .btn-container {
            margin: 15px 0;
            width: 100%;
        }
        button {
            width: 100%;
            padding: 12px;
            background-color: #3498db;
            color: white;
            border: none;
            border-radius: 8px;
            font-size: 1.1rem;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.2s, transform 0.1s;
        }
        button:hover {
            background-color: #2980b9;
        }
        button:active {
            transform: scale(0.98);
        }
        canvas {
            background: #fafafa;
            border: 2px dashed #bdc3c7;
            border-radius: 8px;
            margin: 15px 0;
            display: block;
        }
        #result-box {
            width: 100%;
            background: #e8f8f5;
            border: 2px solid #2ecc71;
            border-radius: 8px;
            padding: 12px;
            text-align: center;
            font-weight: bold;
            color: #27ae60;
            min-height: 50px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 1rem;
        }
    </style>
</head>
<body>

    <div class="container">
        <h1>🪜 5인용 사다리타기 게임</h1>

        <!-- 참가자 이름 입력 -->
        <div class="section">
            <h3>참가자 이름 (5명)</h3>
            <div class="input-group">
                <input type="text" value="참가자1" id="p0">
                <input type="text" value="참가자2" id="p1">
                <input type="text" value="참가자3" id="p2">
                <input type="text" value="참가자4" id="p3">
                <input type="text" value="참가자5" id="p4">
            </div>
        </div>

        <!-- 사다리 캔버스 -->
        <canvas id="ladderCanvas" width="500" height="300"></canvas>

        <!-- 결과 항목 입력 -->
        <div class="section">
            <h3>결과 내용 (5개)</h3>
            <div class="input-group">
                <input type="text" value="당첨 🎉" id="r0">
                <input type="text" value="꽝 😢" id="r1">
                <input type="text" value="커피 ☕" id="r2">
                <input type="text" value="꽝 😢" id="r3">
                <input type="text" value="면제 ✌️" id="r4">
            </div>
        </div>

        <!-- 시작 버튼 -->
        <div class="btn-container">
            <button onclick="startLadder()">사다리 타기 시작!</button>
        </div>

        <!-- 결과 출력 박스 -->
        <div id="result-box">버튼을 눌러 사다리 결과를 확인하세요!</div>
    </div>

    <script>
        const canvas = document.getElementById('ladderCanvas');
        const ctx = canvas.getContext('2d');
        const numCols = 5;
        const width = canvas.width;
        const height = canvas.height;
        const colWidth = width / (numCols + 1);
        
        let ladders = [];
        let resultsMap = [];

        // 기본 사다리 뼈대 그리기
        function drawBaseLadder() {
            ctx.clearRect(0, 0, width, height);
            ctx.strokeStyle = '#bdc3c7';
            ctx.lineWidth = 3;

            // 세로줄 5개
            for (let i = 0; i < numCols; i++) {
                let x = colWidth * (i + 1);
                ctx.beginPath();
                ctx.moveTo(x, 30);
                ctx.lineTo(x, height - 30);
                ctx.stroke();
            }
        }

        // 사다리 구조 무작위 생성
        function generateLadderStructure() {
            ladders = [];
            // 각 세로줄 사이에 가로줄 무작위 생성 (총 5개 행)
            let numRows = 6;
            let rowHeight = (height - 60) / numRows;

            for (let r = 1; r < numRows; r++) {
                let y = 30 + r * rowHeight;
                for (let c = 0; c < numCols - 1; c++) {
                    // 50% 확률로 가로줄 생성, 단 바로 옆에 가로줄이 연속되지 않게 조정
                    if (Math.random() < 0.4) {
                        ladders.push({ x1: colWidth * (c + 1), x2: colWidth * (c + 2), y: y });
                        c++; // 연속 방지
                    }
                }
            }

            // 가로줄 그리기
            ctx.strokeStyle = '#e74c3c';
            ctx.lineWidth = 3;
            ladders.forEach(line => {
                ctx.beginPath();
                ctx.moveTo(line.x1, line.y);
                ctx.lineTo(line.x2, line.y);
                ctx.stroke();
            });
        }

        // 초기 화면 세팅
        function initGame() {
            drawBaseLadder();
            generateLadderStructure();
        }

        initGame();

        // 사다리 경로 계산 및 애니메이션 실행
        function startLadder() {
            initGame();
            
            // 입력된 이름과 결과 가져오기
            let players = [];
            let results = [];
            for (let i = 0; i < numCols; i++) {
                players.push(document.getElementById('p' + i).value);
                results.push(document.getElementById('r' + i).value);
            }

            // 각 출발지(0~4)가 어디로 도착하는지 미리 계산
            resultsMap = [];
            for (let start = 0; start < numCols; start++) {
                let currentPos = start;
                let currentY = 30;
                
                // 세로줄과 가로줄을 따라 이동 시뮬레이션
                // y 좌표 순으로 가로줄 정렬 후 추적
                let sortedLadders = [...ladders].sort((a, b) => a.y - b.y);
                
                // 간단하게 위치 추적 (아래로 내려가며 가로줄 만나면 이동)
                // 정교한 시뮬레이션을 위해 경로를 미리 그릴 수 있게 좌표 배열 생성
                let pathPoints = [{ x: colWidth * (currentPos + 1), y: 30 }];
                
                // y축을 따라 한 단계씩 내려가는 방식 대신 가로줄 이벤트를 순회
                let currentXIndex = currentPos;
                
                // 시각적 애니메이션을 위해 경로를 단계별로 저장
                // (여기서는 간단히 최종 결과 매핑과 애니메이션 실행)
            }

            // 각 참가자별 최종 도착지 계산 로직
            let finalDestinations = [];
            for (let i = 0; i < numCols; i++) {
                let pos = i;
                // y 좌표 순으로 정렬된 가로줄 확인
                let sortedLadders = [...ladders].sort((a, b) => a.y - b.y);
                sortedLadders.forEach(line => {
                    let leftColIndex = (line.x1 / colWidth) - 1;
                    if (pos === leftColIndex) {
                        pos = leftColIndex + 1;
                    } else if (pos === leftColIndex + 1) {
                        pos = leftColIndex;
                    }
                });
                finalDestinations.push(pos);
            }

            // 결과 텍스트 표시
            let summaryText = "🎯 결과 발표! <br>";
            let resultPairs = [];
            for(let i=0; i<numCols; i++) {
                let destIndex = finalDestinations[i];
                resultPairs.push(`${players[i]} ➔ <b>${results[destIndex]}</b>`);
            }
            document.getElementById('result-box').innerHTML = resultPairs.join(' | ');
        }
    </script>
</body>
</html>
